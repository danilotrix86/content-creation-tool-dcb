# Copy to .env.local and fill in your keys

# Text pipeline: gemini (default) or openai
# LLM_PROVIDER=openai

# When LLM_PROVIDER=openai, text uses Chat Completions with strong/fast models
# OPENAI_STRONG_MODEL=gpt-5.4
# OPENAI_FAST_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# Deprecated — use OPENAI_STRONG_MODEL / OPENAI_FAST_MODEL instead
# OPENAI_LLM_MODEL=gpt-4.1

# Sampling temperature for models that support it (default 0.7). Ignored for gpt-5.x / o-series unless you force:
# OPENAI_LLM_TEMPERATURE=0.7
# OPENAI_LLM_OMIT_TEMPERATURE=1

GOOGLE_GEMINI_API=
OPENAI_API_KEY=

# Supabase (articles are saved to generated_articles after each run)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: for competitor + casino research (SerpAPI = SERP, plus a scraper)
SERPAPI_KEY=

# Preferred scraper: Scrape.do (residential/mobile proxies + geo-targeting beat
# the datacenter-IP blocks casino sites use). Falls back to Cloudflare if unset
# or when every Scrape.do profile is blocked.
SCRAPEDO_TOKEN=

# Scrape.do geoCode is derived from search_country per job (e.g. hu → lt when HU proxy is unsupported).

# Skip Scrape.do on machines where api.scrape.do is blocked (local dev); Cloudflare + SERP still run.
# SCRAPEDO_DISABLED=1

# Fallback scraper: Cloudflare Browser Rendering
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Prompt logging: full final prompts sent to each LLM are logged by default.
# Set to 0 to silence them.
# PIPELINE_LOG_PROMPTS=0

# Pipeline debug log files (one .log per generation job under logs/jobs/{jobId}.log).
# Enabled by default in dev; set PIPELINE_LOG_FILE=1 to force on in production, or 0 to disable.
# PIPELINE_LOG_DIR=logs/jobs

# Certificate errors from antivirus/HTTPS inspection — required for Gemini fetch on some setups (NODE_TLS_REJECT_UNAUTHORIZED alone is not enough):
# DEV_TLS_INSECURE=1
